{
  "name": "memory-engine-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "openclaw": {
    "extensions": [
      "index.js"
    ]
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.29.0",
    "better-sqlite3": "^11.10.0"
  },
  "scripts": {
    "check": "node bin/static-check.js",
    "test": "node --test",
    "test:integrity": "node bin/test-integrity-check.js",
    "review": "node bin/review-gate.js",
    "memory:quality": "node bin/memory-quality-eval.js",
    "benchmark:longmemeval:validate": "node bin/benchmark-longmemeval-v1.js",
    "benchmark:locomo:validate": "node bin/benchmark-locomo-v1.js",
    "benchmark:locomo:retrieval": "node bin/run-locomo-retrieval-v1.js",
    "benchmark:locomo:retrieval:time-frozen": "node bin/run-locomo-time-frozen-retrieval-v2.js",
    "benchmark:locomo:semantic:time-frozen": "node bin/run-locomo-semantic-retrieval-v2.js",
    "benchmark:longmemeval:retrieval": "node bin/run-longmemeval-retrieval-v1.js",
    "benchmark:longmemeval:semantic": "node bin/run-longmemeval-semantic-retrieval-v1.js",
    "benchmark:q4:recall-hint:development": "node bin/run-q4-recall-hint-c1b-development-v1.mjs",
    "benchmark:q4:recall-hint:retrieval-effect": "node bin/run-q4-recall-hint-c1b-retrieval-effect-v1.mjs",
    "benchmark:q4:recall-hint:acceptance": "node bin/run-q4-recall-hint-c1b-acceptance-v1.mjs",
    "benchmark:q4:recall-hint:c2-holdout": "node bin/run-q4-recall-hint-c2-holdout-v1.mjs",
    "benchmark:rh-l1:performance": "node bin/run-rh-l1-performance-v1.mjs",
    "benchmark:rh-l1:deterministic-equivalence": "node bin/run-rh-l1-deterministic-equivalence-v1.mjs",
    "benchmark:rh-l1:lancedb-equivalence": "node bin/run-rh-l1-lancedb-equivalence-v1.mjs",
    "benchmark:rh-l3:expansion-contract": "node bin/run-rh-l3-expansion-contract-v1.mjs",
    "benchmark:aml:serve": "node bin/serve-aml-benchmark-v1.js",
    "smoke:quality-baseline": "node bin/run-memory-quality-baseline-smoke.js",
    "smoke:smart-add-duplicates": "node bin/run-smart-add-duplicate-baseline-smoke.js",
    "smoke:full-fail-closed": "node bin/run-full-fail-closed-safety-smoke.js --markdown",
    "smoke:openclaw-state-db-readonly": "node bin/run-openclaw-state-db-readonly-feasibility-smoke.js --json",
    "smoke:openclaw-host-metadata-manifest": "node bin/run-host-plugin-metadata-manifest-smoke.js --json",
    "preview:smart-add-duplicate-cleanup": "node bin/preview-smart-add-duplicate-cleanup-candidates.js",
    "memory:cleanup-orphan-confidence": "node bin/cleanup-orphan-confidence.js",
    "console": "node console/cli.js",
    "smoke:console-annotation-handoff": "node --test test/console-reports.test.js test/console-annotations.test.js test/smoke-tests-index-doc.test.js test/report-archived-raw-log-rescue-review-queue-labels.test.js test/build-archived-raw-log-rescue-review-queue.test.js",
    "version:status": "node bin/version-status.js",
    "version:check": "node bin/version-status.js --check",
    "sync-index": "node bin/sync-memory-index.js --force"
  }
}
