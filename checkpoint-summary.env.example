# Copy to checkpoint-summary.env beside this file. The local file is git-ignored.
# This example contains no credentials or machine-specific proxy settings.
PATH="$HOME/.local/node24/bin:$HOME/.local/bin:$PATH"
MEMORY_ENGINE_NODE_BIN="$HOME/.local/node24/bin/node"
MEMORY_ENGINE_TIME_ZONE=Asia/Shanghai
MEMORY_ENGINE_CHECKPOINT_SUMMARY_MODE=derived
MEMORY_ENGINE_CHECKPOINT_DERIVED_TRANSPORT=codex-cli
MEMORY_ENGINE_CHECKPOINT_CODEX_BINARY="$HOME/.local/bin/codex"
MEMORY_ENGINE_CHECKPOINT_CODEX_MODEL=gpt-6-luna
MEMORY_ENGINE_CHECKPOINT_CODEX_EFFORT=xhigh
MEMORY_ENGINE_CHECKPOINT_CODEX_TIMEOUT_MS=600000
MEMORY_ENGINE_CHECKPOINT_SUMMARY_INPUT_CHARS=200000
MEMORY_ENGINE_CHECKPOINT_SUMMARY_OUTPUT_CHARS=20000

# Scheduler settings are external to this file:
# noOutputTimeoutSeconds=900, timeoutSeconds=3600.
# session-checkpoint.js uses a 1800000 ms (30 minute) round deadline.
